# Database connection URLs (Neon Lakebase Postgres)
# Pooled connection string (for web application runtime & serverless queries)
DATABASE_URL="postgresql://neondb_owner:password@ep-gentle-leaf-azwbrxtc-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct / Unpooled connection string (for Prisma migrations, db push & DDL schema operations)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-gentle-leaf-azwbrxtc.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon branch pointer
NEON_BRANCH=production

# Google Gemini API Key (Server-side & Client-side)
GEMINI_API_KEY="your-gemini-api-key-here"
NEXT_PUBLIC_GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model configuration
GEMINI_MODEL="gemini-3.6-flash"

# JWT Secret Key for Session Authentication (Cookie & Token verification)
JWT_SECRET="mathviz-secure-jwt-secret-key-2026"

# Optional dedicated LaTeX-on-HTTP endpoint. Default: public beta at latex.ytotech.com.
# Source is transmitted to this service; do not use the public engine for confidential documents.
LATEX_COMPILER_URL="https://latex.ytotech.com/builds/sync"
# Optional bearer token for a private compatible gateway (server-side only).
LATEX_COMPILER_TOKEN=""
